{
  "id": "multi-message-mode",
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "slashCommands": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "activate": { "type": "string", "default": "/mma" },
          "deactivate": { "type": "string", "default": "/mmd" },
          "cancel": { "type": "string", "default": "/mmc" }
        }
      },
      "voiceKeywords": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "activate": { "type": "string", "default": "activate" },
          "deactivate": { "type": "string", "default": "deactivate" },
          "cancel": { "type": "string", "default": "cancel" }
        }
      },
      "echoBuffer": { "type": "boolean", "default": false },
      "echoTruncation": { "type": "integer", "default": 200 }
    }
  }
}