{
  "id": "multi-message-mode",
  "enabledByDefault": false,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "slashCommands": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "activate": { "type": "string", "default": "/mmm" },
          "deactivate": { "type": "string", "default": "/mmc" },
          "cancel": { "type": "string", "default": "/mmm-cancel" }
        }
      },
      "voiceKeywords": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "activate": { "type": "string", "default": "multi-message mode" },
          "deactivate": { "type": "string", "default": "multi-message complete" }
        }
      }
    }
  }
}